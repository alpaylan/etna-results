": "24a1d6aaf2c2cbd22ac9d907ffe2a020ea252851"}], "patch": "patches/88f3bf04f831a81641098d8aff32402672a3cc7d-1/20260924T002028Z-e2684ad3.patch", "provenance": "verbatim", "runs": {}, "test_sources": [{"commit": "88f3bf04f831a81641098d8aff32402672a3cc7d", "paths": ["lexical-write-float/src/shared.rs"]}], "tests": ["issue_94_test"]}, "shard": "lexical-core", "status": "blocked", "subject": "Fix serializing -0.0 floats.", "summary": "Negative zero bypasses the writer's self < ZERO sign check, causing default serialization to produce \"0.0\" instead of \"-0.0\". The fix adds an is_sign_negative() branch in the shared formatter that emits '-' and includes it in the output length. This reversal removes that branch while preserving the argument-order refactoring. The fix adds issue_94_test in lexical-write-float/tests/issue_94_tests.rs. No tests were run.", "updated_at": "2026-09-24T00:25:42.067974+00:00"}
