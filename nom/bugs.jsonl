69b1bc8aa2a923192cfc00bf1", "fixed_tree": "1f294c83d55bd3b7c56671f604f966e3dbe1d4a9", "fixes": [{"commit": "7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1", "parent": "12fd3ed0cf8ad87e6d8139c1df018b517ce915d7"}], "patch": "patches/7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1-1/20260925T114453Z-2689a31b.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1-1/20260925T114453Z-2689a31b/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 101, "log": "evidence/7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1-1/20260925T114453Z-2689a31b/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 101, "log": "evidence/7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1-1/20260925T114453Z-2689a31b/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "7f0e9ec68c9aeba69b1bc8aa2a923192cfc00bf1", "paths": ["src/bits.rs"]}], "tests": ["issue_848_overflow_incomplete_bits_to_bytes"]}, "shard": "nom", "status": "blocked", "subject": "fix overflow in the byte wrapper for bit level parsers", "summary": "The bytes! wrapper converted an incomplete byte count into bits using unchecked multiplication by 8. Large counts overflowed, causing a panic with overflow checks or an incorrect wrapped size without them. The fix uses checked_mul and returns Err::Failure with ErrorKind::TooLarge when the bit count cannot fit. The regression test added by this commit requests 0x2000000000000000 bytes from empty input, triggering this overflow on a 64-bit target. It is a top-level test in tests/issues.rs; that integration target requires alloc and regexp_macros. The reversal restores both feature variants of bytes_impl! while preserving the new error variant and unchanged regression test. No builds or tests were run.", "updated_at": "2026-09-25T11:45:37.516428+00:00"}
