lue", "fixed_commit": "517bc7759c88c4d0083c865c38a1570ea6e5087b", "fixed_tree": "20080e64c4829103175f38d85383746f61cd63b5", "fixes": [{"commit": "517bc7759c88c4d0083c865c38a1570ea6e5087b", "parent": "504ff533ac0eba80792bfdc9e849ad918d32d6bd"}], "patch": "patches/517bc7759c88c4d0083c865c38a1570ea6e5087b-1/20260924T204635Z-6a3872d2.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/517bc7759c88c4d0083c865c38a1570ea6e5087b-1/20260924T204635Z-6a3872d2/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 101, "log": "evidence/517bc7759c88c4d0083c865c38a1570ea6e5087b-1/20260924T204635Z-6a3872d2/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 101, "log": "evidence/517bc7759c88c4d0083c865c38a1570ea6e5087b-1/20260924T204635Z-6a3872d2/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "517bc7759c88c4d0083c865c38a1570ea6e5087b", "paths": ["src/error.rs"]}], "tests": ["issue_1027_convert_error_panic_nonempty"]}, "shard": "nom", "status": "blocked", "subject": "fix panic in convert_error", "summary": "convert_error panics when formatting an end-of-input error after parsing 'a' while expecting 'b': without a preceding newline, line_begin incorrectly becomes the error offset, and extracting a line from the empty suffix unwraps None. The fix defaults line_begin to zero and safely handles an empty line iterator. The existing regression test, updated by this fix, checks the formatted diagnostic. It is a top-level test in tests/issues.rs; that integration target requires alloc and regexp_macros features.", "updated_at": "2026-09-24T20:48:10.853810+00:00"}
