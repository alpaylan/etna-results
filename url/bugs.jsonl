3797776d7be1ae4418163c724", "fixed_tree": "28acfa905335af6602f2fd9f9e9bf9cf568804d1", "fixes": [{"commit": "3174ea50f822eb63797776d7be1ae4418163c724", "parent": "6865d52fe424d84b9068d946f6893c52dfa43e5b"}], "patch": "patches/3174ea50f822eb63797776d7be1ae4418163c724-1/20260924T004727Z-84040b50.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/3174ea50f822eb63797776d7be1ae4418163c724-1/20260924T004727Z-84040b50/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/3174ea50f822eb63797776d7be1ae4418163c724-1/20260924T004727Z-84040b50/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/3174ea50f822eb63797776d7be1ae4418163c724-1/20260924T004727Z-84040b50/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "3174ea50f822eb63797776d7be1ae4418163c724", "paths": ["url/src/path_segments.rs"]}], "tests": ["pop_if_empty_in_bounds"]}, "shard": "url", "status": "blocked", "subject": "url: fix panic on popping from Url without path (fixes #656)", "summary": "For a non-special URL with an empty path such as m://, after_first_slash is one byte beyond the serialization length. Both pop_if_empty() and pop() previously sliced from that out-of-bounds position and panicked. The fix adds early returns before slicing when after_first_slash is at or beyond the serialization length. The fix-added test pop_if_empty_in_bounds in url/tests/unit.rs exercises both methods. Reversing both guards should make it panic on pop_if_empty(); no tests were executed in this planning job.", "updated_at": "2026-09-24T00:48:26.581593+00:00"}
