, "fixed_tree": "9092e24b7269deb48d907d5e701a28f46b813aec", "fixes": [{"commit": "a08aa2cd10a67d9922ecd4fa96584cfc97820e87", "parent": "edabc7979357e530feb558add94ba837eb613ab5"}], "patch": "patches/a08aa2cd10a67d9922ecd4fa96584cfc97820e87-1/20260924T003106Z-bb51c365.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/a08aa2cd10a67d9922ecd4fa96584cfc97820e87-1/20260924T003106Z-bb51c365/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/a08aa2cd10a67d9922ecd4fa96584cfc97820e87-1/20260924T003106Z-bb51c365/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/a08aa2cd10a67d9922ecd4fa96584cfc97820e87-1/20260924T003106Z-bb51c365/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "a08aa2cd10a67d9922ecd4fa96584cfc97820e87", "paths": ["url/src/parser.rs"]}], "tests": ["issue_864"]}, "shard": "url", "status": "blocked", "subject": "Fix panic in set_path for file URLs  (#865)", "summary": "Calling set_path(\"x\") on Url::parse(\"file://\") truncates serialization to path_start. The Windows drive-letter check then slices from path_start + 1, past the string's end, causing a panic. The fix guards the slice with serialization.len() > path_start. The fix adds the top-level regression test issue_864 in url/tests/unit.rs. Both selected regions occur exactly once; replacing the fixed region with the parent region exactly restores the parent implementation file. Tests were not run.", "updated_at": "2026-09-24T00:35:07.532195+00:00"}
