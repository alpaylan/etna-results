c0c19ac6752a2a22646735b511e9d462", "patches/ab0f1041c3469bfbc41459b46ee90173b434d067-1/20260924T205350Z-5a467f28.patch": "3e0b6d2d495b7f3d0066ac552b41deed51f5ad5c669db87642d61aeaa15a3af1"}, "expected_failure": "Failed to parse:\n```\nfoo = 1979-05-27 # Comment\n\n```", "expected_failure_match": true, "failure": "parser::tests::documents panicked: Parse error: TOML parse error at line 1, column 18\n  |\n1 | foo = 1979-05-27 # Comment\n  |                  ^\nUnexpected `#`\nexpected 2 more elements\nWhile parsing a Date-Time\n\nFailed to parse:\n```\nfoo = 1979-05-27 # Comment\n\n```", "fixed_commit": "ab0f1041c3469bfbc41459b46ee90173b434d067", "fixed_tree": "bfbdf99f7e333eae3933363241e4e732d3748b55", "fixes": [{"commit": "ab0f1041c3469bfbc41459b46ee90173b434d067", "parent": "9e81c5a9e380f06bddee7e26ccec70e95acdb4a5"}], "patch": "patches/ab0f1041c3469bfbc41459b46ee90173b434d067-1/20260924T205350Z-5a467f28.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/ab0f1041c3469bfbc41459b46ee90173b434d067-1/20260924T205350Z-5a467f28/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/ab0f1041c3469bfbc41459b46ee90173b434d067-1/20260924T205350Z-5a467f28/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/ab0f1041c3469bfbc41459b46ee90173b434d067-1/20260924T205350Z-5a467f28/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "Parse error: TOML parse error at line 1, column 18\n  |\n1 | foo = 1979-05-27 # Comment\n  |                  ^\nUnexpected `#`\nexpected 2 more elements\nWhile parsing a Date-Time\n\nFailed to parse:\n```\nfoo = 1979-05-27 # Comment\n\n```", "test_sources": [{"commit": "ab0f1041c3469bfbc41459b46ee90173b434d067", "paths": ["src/parser/datetime.rs"]}], "tests": ["parser::tests::documents"]}, "shard": "toml_edit", "status": "confirmed", "subject": "fix: Don't confuse trailing whitespace as date/time separator", "summary": "The parser incorrectly consumes trailing space after a local date as a date/time separator, rejecting valid input such as `foo = 1979-05-27 # Comment`. The fix checks for an hour after the separator and backtracks when absent, allowing the space and comment to be parsed normally. The fix adds this regression case to parser::tests::documents. Both reversal regions occur exactly once; replacing the fixed region restores the parent implementation file exactly. No tests were run.", "updated_at": "2026-09-24T20:56:55.510781+00:00"}
