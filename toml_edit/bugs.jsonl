f86b6b14a-1/20260924T003034Z-60e4758c/setup-0.log": "3af7b89be23d60653f7862c79e16db0ad43a0470c12bce40706a6a8e5d1a4cf4", "evidence/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c/setup-1.log": "aad94f50c472be9a5b24d97d5c390ed1c022139722d09615ec45ee3666a597ad", "evidence/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c/setup-2.log": "1af60ea311c09a1d3dca2d9e283ecac7383e4c3cfff654efc4564af7c5df5ebf", "evidence/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c/setup-3.log": "b0b04a0f3ee27001dd5e40dd2ba4e210ffcb5032106976c5d457110272ca7968", "evidence/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c/setup-4.log": "d99a4a4f82bb6faf999e3c21da8ac52067fb67a4fa4a8514f0a0c95c8c6432a4", "patches/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c.patch": "da15e8bfd7666cca3c112416215c0c62af48fbf4c66681f87e4bd4af908bac66"}, "expected_failure": "setting a value should set a prefix", "fixed_commit": "b91d460cc8584110c95d8eb7fcb2f45f86b6b14a", "fixed_tree": "5f278bb3815e509ae0433b1a2789c9dd2bd33220", "fixes": [{"commit": "b91d460cc8584110c95d8eb7fcb2f45f86b6b14a", "parent": "c8087a6bc6ff1464c5731fca0f70404ec200226f"}], "patch": "patches/b91d460cc8584110c95d8eb7fcb2f45f86b6b14a-1/20260924T003034Z-60e4758c.patch", "provenance": "verbatim", "runs": {}, "test_sources": [{"commit": "b91d460cc8584110c95d8eb7fcb2f45f86b6b14a", "paths": ["crates/toml_parser/src/parser/document.rs"]}], "tests": ["parse::garbage1"]}, "shard": "toml_edit", "status": "blocked", "subject": "fix(edit): Don't panic on inline table keys without values", "summary": "At EOF, an unfinished inline table in NeedsEquals or NeedsValue state closed without emitting missing separator or scalar events, causing toml_edit to panic on malformed input such as `={=<=u==`. The fix emits those events before reporting the unclosed table, preserving receiver state so parsing returns an error. The fix updates parse::garbage1 in toml_edit's compliance test target to check that error instead of expecting a panic. The proposed reversal exactly restores the parent implementation and preserves the updated test. No tests were run.", "updated_at": "2026-09-24T00:34:58.921727+00:00"}
