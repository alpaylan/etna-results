e": "capacity overflow", "expected_failure_match": true, "failure": "rtree::test::test_remove_capacity panicked: capacity overflow", "fixed_commit": "44e1bf54192ad96672a465fcf95025180e540c3d", "fixed_tree": "0f4a67330843deaf47e439ca8aab338b51fdb9c3", "fixes": [{"commit": "44e1bf54192ad96672a465fcf95025180e540c3d", "parent": "1701a8d5ebfe16c420f9bfeffe48756f9a1efee8"}], "patch": "patches/44e1bf54192ad96672a465fcf95025180e540c3d-1/20260924T002551Z-ab5f538e.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/44e1bf54192ad96672a465fcf95025180e540c3d-1/20260924T002551Z-ab5f538e/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/44e1bf54192ad96672a465fcf95025180e540c3d-1/20260924T002551Z-ab5f538e/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/44e1bf54192ad96672a465fcf95025180e540c3d-1/20260924T002551Z-ab5f538e/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "capacity overflow", "test_sources": [{"commit": "44e1bf54192ad96672a465fcf95025180e540c3d", "paths": ["rstar/src/algorithm/removal.rs"]}], "tests": ["rtree::test::test_remove_capacity"]}, "shard": "rstar", "status": "confirmed", "subject": "Fix panic when setting RTreeParams MIN_SIZE to 1", "summary": "Removing an item from a two-item RTree with MIN_SIZE = 1 computes the drain stack capacity using log base 1. This yields positive infinity, which casts to usize::MAX and causes Vec::with_capacity to panic. The fix clamps the logarithm base to at least 2, producing a finite capacity. The regression test added by this commit exercises this case. This plan reverses only that clamp; reproduction remains for the runner.", "updated_at": "2026-09-24T00:28:19.002882+00:00"}
