atch": "patches/5f5ca4db28f83cf491251c892f99e796f14263c4-1/20260924T173249Z-d86ccc61.patch", "provenance": "verbatim", "runs": {}, "test_sources": [{"commit": "5f5ca4db28f83cf491251c892f99e796f14263c4", "paths": ["src/block/decompress_safe.rs"]}], "tests": ["checked_decode::error_case_4"]}, "shard": "lz4_flex", "status": "blocked", "subject": "fix: checked-decode", "summary": "The safe decoder subtracts an invalid match offset from the output position without checking for underflow. The fix-added error_case_4 supplies offset 7 with output position 0 and match length 4, reaching duplicate_slice and causing a subtraction-overflow panic in debug builds. The fix detects underflow and returns OffsetOutOfBounds. Reverse only this bounds check. Run the existing test with default features (including safe-decode) plus checked-decode, which prevents the test from being ignored. No tests were executed in this planning job.", "updated_at": "2026-09-24T17:36:11.442196+00:00"}
