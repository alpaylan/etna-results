it": "0e48d4a5ece68263df3a968935316c36ca7b9f55", "fixed_tree": "79032c9748c9f97da52059a6bbe4c7a6d0f1b5ab", "fixes": [{"commit": "0e48d4a5ece68263df3a968935316c36ca7b9f55", "parent": "0e17e08a740d956bc9016e36db5aa034828681bb"}], "patch": "patches/0e48d4a5ece68263df3a968935316c36ca7b9f55-1/20260924T174544Z-ac717105.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/0e48d4a5ece68263df3a968935316c36ca7b9f55-1/20260924T174544Z-ac717105/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/0e48d4a5ece68263df3a968935316c36ca7b9f55-1/20260924T174544Z-ac717105/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/0e48d4a5ece68263df3a968935316c36ca7b9f55-1/20260924T174544Z-ac717105/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "0e48d4a5ece68263df3a968935316c36ca7b9f55", "paths": ["compact_str/src/lib.rs"]}], "tests": ["tests::test_retain"]}, "shard": "compact_str", "status": "blocked", "subject": "fix: retain not set len if predicate panics (#413)", "summary": "CompactString::retain updates its length only after iteration, so a predicate panic can leave partially compacted bytes exposed at the original length, violating UTF-8 validity. The added test removes the first character of \"0\u00e80\", retains '\u00e8', then panics on the last character and checks UTF-8 validity after catching the panic. The fix uses a drop guard to set the length to the retained prefix during both normal completion and unwinding. This is a source-inspected plan; no tests were run.", "updated_at": "2026-09-24T17:52:20.041579+00:00"}
