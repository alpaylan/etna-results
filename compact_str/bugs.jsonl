it": "042b64a8a2ff225e9485d7676a53a503ba467d6f", "fixed_tree": "c3e0a7cbd588c79ca84d243436c179b33b197431", "fixes": [{"commit": "042b64a8a2ff225e9485d7676a53a503ba467d6f", "parent": "5c8b856ab3d4596feec508f332dfbb3cbe0fa13a"}], "patch": "patches/042b64a8a2ff225e9485d7676a53a503ba467d6f-1/20260923T231309Z-393f368a.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/042b64a8a2ff225e9485d7676a53a503ba467d6f-1/20260923T231309Z-393f368a/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/042b64a8a2ff225e9485d7676a53a503ba467d6f-1/20260923T231309Z-393f368a/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/042b64a8a2ff225e9485d7676a53a503ba467d6f-1/20260923T231309Z-393f368a/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "042b64a8a2ff225e9485d7676a53a503ba467d6f", "paths": ["compact_str/src/lib.rs"]}], "tests": ["tests::test_retain"]}, "shard": "compact_str", "status": "blocked", "subject": "fix: retain not set len if predicate panics (#413)", "summary": "CompactString::retain updated its length only on normal completion. A predicate panic after compacting characters left the original length, potentially exposing invalid UTF-8. The regression test added by the fix removes the first '0' from \"0\u00e80\", retains '\u00e8', then panics on the final character; the stale length exposes a stray continuation byte. The fix uses a drop guard to truncate to the retained prefix even during unwinding. The proposed reversal restores the exact parent implementation and preserves the upstream test. No tests were run.", "updated_at": "2026-09-23T23:19:48.705440+00:00"}
