s": [{"commit": "cb431a612a39fb7973f7a7218771b5b3fd43d979", "parent": "da13ed17e7a2fe85d8486730e0911a9d875f44ad"}], "patch": "patches/cb431a612a39fb7973f7a7218771b5b3fd43d979-1/20260924T001931Z-b8c1957d.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/cb431a612a39fb7973f7a7218771b5b3fd43d979-1/20260924T001931Z-b8c1957d/buggy.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/cb431a612a39fb7973f7a7218771b5b3fd43d979-1/20260924T001931Z-b8c1957d/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/cb431a612a39fb7973f7a7218771b5b3fd43d979-1/20260924T001931Z-b8c1957d/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "test_sources": [{"commit": "cb431a612a39fb7973f7a7218771b5b3fd43d979", "paths": ["src/nodes/rrb.rs"]}], "tests": ["vector::test::issue_55_back"]}, "shard": "im-rs", "status": "unconfirmed", "subject": "Many Vector merging/splitting bug fixes.", "summary": "Node::parent treated a child with a full array of child pointers as completely dense even when its descendants were sparse. This incorrectly retained Size::Size accounting, causing incorrect subtree offsets during indexing and splitting. The fix checks is_completely_dense(level - 1), forcing cumulative Size::Table accounting for a sparse nonfinal child. The upstream issue_55_back regression test exercises repeated prepending followed by indexing and slicing. This is a proposed reversal; reproduction has not been run.", "updated_at": "2026-09-24T00:20:37.509539+00:00"}
