s": [{"commit": "b9c57c278742e095889c2ee1354c3efbd3eb7274", "parent": "a8e2a7add93a4856758ece70429753ff8ad2b3ab"}], "patch": "patches/b9c57c278742e095889c2ee1354c3efbd3eb7274-1/20260924T000642Z-5e3853b5.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/b9c57c278742e095889c2ee1354c3efbd3eb7274-1/20260924T000642Z-5e3853b5/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/b9c57c278742e095889c2ee1354c3efbd3eb7274-1/20260924T000642Z-5e3853b5/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/b9c57c278742e095889c2ee1354c3efbd3eb7274-1/20260924T000642Z-5e3853b5/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "test_sources": [{"commit": "b9c57c278742e095889c2ee1354c3efbd3eb7274", "paths": ["src/lib.rs"]}], "tests": ["tests::test_label_resolution"]}, "shard": "encoding_rs", "status": "unconfirmed", "subject": "Make overlong bogus labels not panic.", "summary": "Encoding::for_label checked whether trimmed_pos exceeded its 19-byte buffer length after writing. At 19 bytes the check allowed another iteration, so the 20-byte label \"bogusbogusbogusbogus\" panicked instead of returning None. The fix changes > to ==, returning before another write. Reversing only the default-byte branch restores the bug exercised by the regression test added in this commit.", "updated_at": "2026-09-24T00:08:20.974787+00:00"}
{"commit": "234bf08f703e0e5cccdd35b1d009e64ac95b450c", "id": "234bf08f703e0e5cccdd35b1d009e64ac95b450c-1", "language": "rust", "reason": "Proposal names no upstream test", "repo": "https://github.com/hsivonen/encoding_rs", "reproduction": {"attempt": "20260924T001716Z-f4699d06", "evidence_sha256": {"evidence/234bf08f703e0e5cccdd35b1d009e64ac95b450c-1/20260924T001716Z-f4699d06/origin.json": "703c60a2d2020206ac326f00af59c026dd9442f2b859a8f2676ad30c4efd128a", "evidence/234bf08f703e0e5cccdd35b1d009e64ac95b450c-1/20260924T001716Z-f4699d06/proposal.json": "d226c149cb68c21349f310662df5c62760415c0491cb3ac51042b7c3c684ebee"}, "provenance": "verbatim"}, "shard": "encoding_rs", "status": "blocked", "subject": "Avoid panic when the output buffer is too short for an NCR.", "summary": "`Encoder::encode_from_utf8` subtracted `NCR_EXTRA` from the destination length without first checking that the buffer was long enough; on a non-UTF target the subtraction underflowed `usize`, and the huge subslice index panicked instead of returning `CoderResult::OutputFull`.", "updated_at": "2026-09-24T00:17:16.767393+00:00"}
{"commit": "d894e27dfad14ec3b76e39e99dbb4fd00552a1dc", "id": "d894e27dfad14ec3b76e39e99dbb4fd00552a1dc-1", "language": "rust", "reason": "Proposal names no upstream test", "repo": "https://github.com/hsivonen/encoding_rs", "reproduction": {"attempt": "20260924T001721Z-a948dcf7", "evidence_sha256": {"evidence/d894e27dfad14ec3b76e39e99dbb4fd00552a1dc-1/20260924T001721Z-a948dcf7/origin.json": "5d7b1ab701c120746a2f0ecbb5797de9400d377dd6ffe70243261e379eca741a", "evidence/d894e27dfad14ec3b76e39e99dbb4fd00552a1dc-1/20260924T001721Z-a948dcf7/proposal.json": "6a794c5a72d7a0acec1867ec812a7b1bf66860e622f855016e256fb7779c75bb"}, "provenance": "verbatim"}, "shard": "encoding_rs", "status": "blocked", "subject": "Fix subslicing with bad indices in `Encoder::encode_from_utf16`.", "summary": "`Encoder::encode_from_utf16` advanced `total_written` past `effective_dst_len` when writing an NCR into a buffer that had room for exactly one NCR but not another, then subsliced `dst[total_written..effective_dst_len]` with `total_written > effective_dst_len` and panicked; the fix stops iterating as soon as the NCR consumes all remaining room.", "updated_at": "2026-09-24T00:17:21.841445+00:00"}
