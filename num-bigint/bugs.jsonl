erflow_2 panicked: assertion failed: carry == 0", "fixed_commit": "8008707fea97b9215f3b949a0eb6044aec709a31", "fixed_tree": "988dc003dbaf178c2397877a6cbe71d678f1e8da", "fixes": [{"commit": "8008707fea97b9215f3b949a0eb6044aec709a31", "parent": "0940e509dca55d19197adbe7cb5c1d5423a390cf"}], "patch": "patches/8008707fea97b9215f3b949a0eb6044aec709a31-1/20260924T002102Z-de06f402.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/8008707fea97b9215f3b949a0eb6044aec709a31-1/20260924T002102Z-de06f402/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/8008707fea97b9215f3b949a0eb6044aec709a31-1/20260924T002102Z-de06f402/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/8008707fea97b9215f3b949a0eb6044aec709a31-1/20260924T002102Z-de06f402/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "assertion failed: carry == 0", "test_sources": [{"commit": "8008707fea97b9215f3b949a0eb6044aec709a31", "paths": ["src/biguint/multiplication.rs"]}], "tests": ["test_mul_overflow_2"]}, "shard": "num-bigint", "status": "confirmed", "subject": "Fix an undersized buffer panic in multiplication", "summary": "Multiplication allocated buffers without the extra digit needed by intermediate recursive calculations, causing large products to panic. The fix adds one digit to the mul3 result buffer and the mac3 temporary buffer. This reversal restores the undersized mul3 buffer. The fix adds test_mul_overflow_2 in tests/biguint.rs, which checks squares of large values of the form 2^n - 1. No tests were executed.", "updated_at": "2026-09-24T00:22:23.152060+00:00"}
