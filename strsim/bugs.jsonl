a5dc7e33d73823-1/20260923T151907Z-a523dd0c/setup-3.log": "f4edfe6d09deb106078608ba230ddc9c27d870bfa4a120e18f37023891581031", "patches/5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823-1/20260923T151907Z-a523dd0c.patch": "3512444761a5a7ff0d1fa5772af431b9ba08e7456e6df515e03951465b15691b"}, "expected_failure": "assertion failed: (0.6 - jaro(\"a jke\", \"jane a k\")).abs() < 0.001", "expected_failure_match": true, "failure": "tests::jaro_diff_with_transposition panicked: assertion failed: (0.6 - jaro(\"a jke\", \"jane a k\")).abs() < 0.001", "fixed_commit": "5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823", "fixed_tree": "31f1347a84204a6a1cbf9bde481a7036495dbc30", "fixes": [{"commit": "5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823", "parent": "cd2e7b3bddceb17bcac0fe319f6fd325107be7ce"}], "patch": "patches/5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823-1/20260923T151907Z-a523dd0c.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823-1/20260923T151907Z-a523dd0c/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823-1/20260923T151907Z-a523dd0c/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823-1/20260923T151907Z-a523dd0c/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "assertion failed: (0.6 - jaro(\"a jke\", \"jane a k\")).abs() < 0.001", "test_sources": [{"commit": "5b512dce33d186f4fbe7ed3fa7a5dc7e33d73823", "paths": ["src/lib.rs"]}], "tests": ["tests::jaro_diff_with_transposition"]}, "shard": "strsim", "status": "confirmed", "subject": "Fix transposition counting in Jaro / JaroWinkler (#56)", "summary": "The original Jaro implementation counts transpositions only when a match precedes the previous matched position in the second sequence. This undercounts reordered matches and can produce asymmetric similarity scores: the added regression assertion expects approximately 0.6 for jaro(\"a jke\", \"jane a k\"), whereas the old counter yields approximately 0.683. The fix records matched positions in both sequences, compares their matched elements in order, and halves the mismatch count. The reversal restores the original matching and scoring region while preserving the fixed search-range handling and all upstream tests. Both source regions occur exactly once in their respective revisions. No tests were run.", "updated_at": "2026-09-23T15:19:23.063330+00:00"}
{"commit": "f8d8c1fff8696ed8026943e2142d164c956032df", "id": "f8d8c1fff8696ed8026943e2142d164c956032df-1", "language": "rust", "reason": "fixed_text does not occur exactly once at the fixed revision", "repo": "https://github.com/rapidfuzz/strsim-rs", "reproduction": {"attempt": "20260924T002953Z-7f5d5cf9", "evidence_sha256": {"evidence/f8d8c1fff8696ed8026943e2142d164c956032df-1/20260924T002953Z-7f5d5cf9/origin.json": "cf07226b5ddcf49fec1780c736c703000ccb470e2c5ab8bb3ef1e0e043e0b45d", "evidence/f8d8c1fff8696ed8026943e2142d164c956032df-1/20260924T002953Z-7f5d5cf9/proposal.json": "f9e68b6c87d430276dd49429ddba97ab9f221c8e3a3acdbdf1a530ad0690320e"}, "provenance": "verbatim"}, "shard": "strsim", "status": "blocked", "subject": "Fix Damerau-Levenshtein (#12)", "summary": "The pre-#12 `damerau_levenshtein` was actually computing optimal-string-alignment distance: each substring could be edited at most once, so adjacent transpositions could not be re-used. The fix renames the OSA implementation to `osa_distance` and introduces a new `damerau_levenshtein` that allows unrestricted edit reuse, satisfying the triangle inequality.", "updated_at": "2026-09-24T00:29:53.323317+00:00"}
