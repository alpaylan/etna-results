ed_commit": "68c127e52156690d061b54e2ccb25a58bc46c6de", "fixed_tree": "1406a73b5d01a43285c0ff59eaa8256865e54442", "fixes": [{"commit": "68c127e52156690d061b54e2ccb25a58bc46c6de", "parent": "091fb72c5e9cd1f06f4d3df1315ed7011a201084"}], "patch": "patches/68c127e52156690d061b54e2ccb25a58bc46c6de-1/20260924T205536Z-11b2485e.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/68c127e52156690d061b54e2ccb25a58bc46c6de-1/20260924T205536Z-11b2485e/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/68c127e52156690d061b54e2ccb25a58bc46c6de-1/20260924T205536Z-11b2485e/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/68c127e52156690d061b54e2ccb25a58bc46c6de-1/20260924T205536Z-11b2485e/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "test_sources": [{"commit": "68c127e52156690d061b54e2ccb25a58bc46c6de", "paths": ["src/sentence.rs"]}], "tests": ["test_size_hint_is_a_valid_bound"]}, "shard": "unicode-segmentation", "status": "unconfirmed", "subject": "Fix size_hint underflow on empty-string sentence iterators (#181)", "summary": "On an empty string, USentenceBounds::size_hint subtracts 1 from an inner lower bound of 0. This panics with overflow checks enabled and otherwise wraps to usize::MAX, violating the iterator bound. The fix uses saturating_sub(1) for both bounds. The added test in tests/test.rs checks bounds against actual counts, starting with the empty string. The reversal includes the removed core::cmp import so the parent implementation can compile; intervening implementation text is unchanged. No tests were run.", "updated_at": "2026-09-24T21:03:46.263540+00:00"}
