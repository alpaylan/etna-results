led", "fixed_commit": "c4865a0c8446a701e10b0fd987f19068f5dcc365", "fixed_tree": "b1df2d8250362581e6d664c7bc18e5649847a383", "fixes": [{"commit": "c4865a0c8446a701e10b0fd987f19068f5dcc365", "parent": "d8761c00ed25c5899e3dcfb0f17e827b8e41530a"}], "patch": "patches/c4865a0c8446a701e10b0fd987f19068f5dcc365-1/20260924T005724Z-4798a36c.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/c4865a0c8446a701e10b0fd987f19068f5dcc365-1/20260924T005724Z-4798a36c/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/c4865a0c8446a701e10b0fd987f19068f5dcc365-1/20260924T005724Z-4798a36c/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/c4865a0c8446a701e10b0fd987f19068f5dcc365-1/20260924T005724Z-4798a36c/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "c4865a0c8446a701e10b0fd987f19068f5dcc365", "paths": ["regex-syntax/src/hir/translate.rs"]}], "tests": ["hir::translate::tests::class_unicode_gencat"]}, "shard": "regex", "status": "blocked", "subject": "syntax: fix negation handling in HIR translation", "summary": "hir_unicode_class ignored the != operator by consulting only the negated field, which tracks the \\p versus \\P sigil. Consequently, \\p{gc!=Separator} matched separators instead of their complement, and \\P{gc!=separator} incorrectly matched the complement. Calling is_negated() combines both sources of negation correctly. The fix adds a detecting assertion to class_unicode_gencat, enabled by the default unicode-gencat feature. This is a proposed reversal; no tests were run.", "updated_at": "2026-09-24T01:03:48.222223+00:00"}
