36cfab8b3544"}, "expected_failure": "called `Result::unwrap()` on an `Err` value: DeserializeUnexpectedEnd", "expected_failure_match": true, "failure": "test::signed_int128 panicked: called `Result::unwrap()` on an `Err` value: DeserializeUnexpectedEnd", "fixed_commit": "70ea33a1ac7f82632697f4578002267eaf9095f5", "fixed_tree": "e6481fdf9da0a140420e5055cd8c01e8ba83ded6", "fixes": [{"commit": "70ea33a1ac7f82632697f4578002267eaf9095f5", "parent": "08e38e65567028b7328c685ecf38005f1a84b614"}], "patch": "patches/70ea33a1ac7f82632697f4578002267eaf9095f5-1/20260924T002204Z-de8f3668.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/70ea33a1ac7f82632697f4578002267eaf9095f5-1/20260924T002204Z-de8f3668/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/70ea33a1ac7f82632697f4578002267eaf9095f5-1/20260924T002204Z-de8f3668/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/70ea33a1ac7f82632697f4578002267eaf9095f5-1/20260924T002204Z-de8f3668/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "called `Result::unwrap()` on an `Err` value: DeserializeUnexpectedEnd", "test_sources": [{"commit": "70ea33a1ac7f82632697f4578002267eaf9095f5", "paths": ["src/de/deserializer.rs"]}], "tests": ["test::signed_int128"]}, "shard": "postcard", "status": "confirmed", "subject": "Fix deserialization of i128", "summary": "The i128 decoder read 16 raw little-endian bytes although the serializer emits zig-zag-encoded varints, causing unexpected-end errors or incorrect values. The fix reads a u128 varint and reverses zig-zag encoding. The regression test added by this commit serializes a negative i128 whose encoding is shorter than 16 bytes, so the proposed reversal should cause deserialization to return DeserializeUnexpectedEnd. No tests were executed.", "updated_at": "2026-09-24T00:23:44.301800+00:00"}
