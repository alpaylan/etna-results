d20663990b513a71ad3523e5d66d774b0c0ebc06a0c3b95"}, "expected_failure": "range end index 12 out of range for slice of length 11", "expected_failure_match": true, "failure": "accumulator::extend_unchecked_in_bounds_test panicked: range end index 12 out of range for slice of length 11", "fixed_commit": "41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df", "fixed_tree": "f06c67994f1933cd09cb6081559a3f7bcf256afe", "fixes": [{"commit": "41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df", "parent": "9d8cf0e26a60fb4ed7364b94323690b340bd8df4"}], "patch": "patches/41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df-1/20260924T002214Z-d781236b.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 101, "log": "evidence/41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df-1/20260924T002214Z-d781236b/buggy.log", "named_result": "FAILED", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df-1/20260924T002214Z-d781236b/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df-1/20260924T002214Z-d781236b/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "signature": "range end index 12 out of range for slice of length 11", "test_sources": [{"commit": "41c2ddbdfc42e08e8eb2aa539a2a46806e65f4df", "paths": ["src/accumulator.rs"]}], "tests": ["accumulator::extend_unchecked_in_bounds_test"]}, "shard": "postcard", "status": "confirmed", "subject": "fix: cobs accumulator out-of-bounds index when data is 1 byte too long (#90)", "summary": "The accumulator's capacity check excluded the terminating sentinel, although the copied slice included it. A 12-byte frame fed to an 11-byte accumulator therefore passed the check and panicked on out-of-bounds slicing. The fix checks take.len(), including the sentinel, so the accumulator returns FeedResult::OverFull. The fix adds the selected regression test. This plan has not been executed.", "updated_at": "2026-09-24T00:24:51.776440+00:00"}
