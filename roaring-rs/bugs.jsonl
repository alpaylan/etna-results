ight: None", "fixed_commit": "3116bccab187a639238cd50754935400a433a3c5", "fixed_tree": "0c0a86cf5789099b16ddc377f4dcc266c0f5d9e5", "fixes": [{"commit": "3116bccab187a639238cd50754935400a433a3c5", "parent": "d9c476b55a248a4283e14be4125fa892d1e53fbc"}], "patch": "patches/3116bccab187a639238cd50754935400a433a3c5-1/20260924T002432Z-5c35466e.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/3116bccab187a639238cd50754935400a433a3c5-1/20260924T002432Z-5c35466e/buggy.log", "named_result": null, "tests_run": 0, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/3116bccab187a639238cd50754935400a433a3c5-1/20260924T002432Z-5c35466e/fixed.log", "named_result": null, "tests_run": 0, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/3116bccab187a639238cd50754935400a433a3c5-1/20260924T002432Z-5c35466e/restored.log", "named_result": null, "tests_run": 0, "timed_out": false}}, "test_sources": [{"commit": "3116bccab187a639238cd50754935400a433a3c5", "paths": ["roaring/src/bitmap/store/interval_store.rs"]}], "tests": ["advance_run_past_the_end"]}, "shard": "roaring-rs", "status": "blocked", "subject": "fix: when advancing past the begin/end of a range container's iter, consume the whole thing", "summary": "RunIter::advance_to returned without consuming remaining intervals when its target exceeded every value, allowing subsequent next() calls to yield values below the target. The fix calls self.intervals.nth(index) when index equals the remaining interval count, exhausting the iterator. Reversing only this forward-iteration correction should make the fix-added test in roaring/tests/iter_advance_to.rs return Some(196608) instead of None after advancing past 0x35B00. Both source regions occur exactly once in their respective revisions. No tests were run.", "updated_at": "2026-09-24T00:31:43.348589+00:00"}
