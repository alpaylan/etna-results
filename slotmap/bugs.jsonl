ed_commit": "2ef68bccaf6dcb8aea983b133a42f57728fac90b", "fixed_tree": "7986ed71d3c7e5464e54daaad3b567a39746b5e8", "fixes": [{"commit": "2ef68bccaf6dcb8aea983b133a42f57728fac90b", "parent": "3b40daf0e82c61ff26e767206f5fc87d4d3cfd78"}], "patch": "patches/2ef68bccaf6dcb8aea983b133a42f57728fac90b-1/20260924T181227Z-7dfde7c3.patch", "provenance": "verbatim", "restored_source_matches": true, "runs": {"buggy": {"exit_code": 0, "log": "evidence/2ef68bccaf6dcb8aea983b133a42f57728fac90b-1/20260924T181227Z-7dfde7c3/buggy.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "fixed": {"exit_code": 0, "log": "evidence/2ef68bccaf6dcb8aea983b133a42f57728fac90b-1/20260924T181227Z-7dfde7c3/fixed.log", "named_result": "ok", "tests_run": 1, "timed_out": false}, "restored": {"exit_code": 0, "log": "evidence/2ef68bccaf6dcb8aea983b133a42f57728fac90b-1/20260924T181227Z-7dfde7c3/restored.log", "named_result": "ok", "tests_run": 1, "timed_out": false}}, "test_sources": [{"commit": "2ef68bccaf6dcb8aea983b133a42f57728fac90b", "paths": ["src/lib.rs"]}], "tests": ["tests::macro_expansion"]}, "shard": "slotmap", "status": "unconfirmed", "subject": "Fixed wrong assumption of new_key_type that the Key trait was in scope.", "summary": "With the serde feature enabled, new_key_type! generates self.data(), which fails to compile when the caller has not imported the Key trait. The fix uses $crate::Key::data(self), removing that scope dependency. The added tests::macro_expansion exercises this case. Detection requires serde and is a compilation failure, so it cannot satisfy the reproduction contract's requirement that the buggy test target builds and an executed test fails. No builds or tests were run.", "updated_at": "2026-09-24T18:13:54.786087+00:00"}
